{
  "name": "perfect-typescripter",
  "version": "1.39.0",
  "private": true,
  "description": "Claude Code plugin + bundled ESLint plugin enforcing Rust-style discipline on TypeScript. The npm-publishable package is in ./eslint-plugin.",
  "license": "MIT",
  "author": "CheckPickerUpper",
  "repository": {
    "type": "git",
    "url": "https://github.com/CheckPickerUpper/perfect-typescripter.git"
  },
  "bugs": {
    "url": "https://github.com/CheckPickerUpper/perfect-typescripter/issues"
  },
  "homepage": "https://github.com/CheckPickerUpper/perfect-typescripter#readme",
  "scripts": {
    "test": "node test/typescript_guard.test.js && node test/phantom_type_params.test.js && node test/why-tag-guard.test.js && node --test test/cross-file-rules.test.js",
    "test:typescript-guard": "node test/typescript_guard.test.js",
    "test:phantom-type-params": "node test/phantom_type_params.test.js",
    "test:why-tag-guard": "node test/why-tag-guard.test.js",
    "test:bun-lint": "node --test test/bun-lint-plugin.test.js",
    "test:cross-file": "node --test test/cross-file-rules.test.js"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.73.0",
    "@typescript/cli": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
